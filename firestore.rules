rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Impostazioni Utente: ogni utente può leggere/scrivere solo il proprio documento
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Progetti
    match /projects/{projectId} {
      // Solo il proprietario (campo userId) può leggere o eliminare il progetto.
      // I progetti senza userId non sono accessibili a nessuno.
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // L'update deve lasciare l'utente corrente come proprietario: impedisce di
      // "regalare" un progetto a un altro utente o di rimuovere il campo userId.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      
      // Permettiamo la creazione solo se l'utente assegna se stesso come proprietario
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Task (Sottocollezione di projects)
      match /tasks/{taskId} {
        // Un utente può leggere/scrivere le task se ha accesso al progetto padre
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }
    }
  }
}
